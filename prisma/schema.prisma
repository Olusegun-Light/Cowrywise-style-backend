// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  bvn           String?
  nin           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet Wallet?

  savingsPlans SavingsPlan[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

enum TransactionType {
  FUNDING
  WITHDRAWAL
  SAVINGS_FUNDING
  SAVINGS_WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id                String            @id @default(uuid())
  walletId          String
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  savingsPlanId     String?
  savingsPlan       SavingsPlan?      @relation(fields: [savingsPlanId], references: [id])
  type              TransactionType
  amount            BigInt
  status            TransactionStatus @default(PENDING)
  providerReference String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum SavingsPlanType {
  FLEX
  FIXED
  RECURRING
}

enum SavingsPlanStatus {
  ACTIVE
  WITHDRAWN
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model SavingsPlan {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id])
  planType             SavingsPlanType
  targetAmount         BigInt
  currentBalance       BigInt              @default(0)
  maturityDate         DateTime?
  frequency            RecurringFrequency?
  recurringAmount      BigInt?
  lastRecurringDebitAt DateTime?
  status               SavingsPlanStatus   @default(ACTIVE)
  lastAccruedAt        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  transactions     Transaction[]
  interestAccruals InterestAccrual[]
}

model InterestAccrual {
  id            String      @id @default(uuid())
  savingsPlanId String
  savingsPlan   SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  accrualDate   DateTime    @db.Date
  amount        BigInt
  createdAt     DateTime    @default(now())

  @@unique([savingsPlanId, accrualDate])
}
