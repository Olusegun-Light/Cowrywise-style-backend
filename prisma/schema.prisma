// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  roleId        String?
  role          Role?    @relation(fields: [roleId], references: [id])
  bvn           String?
  nin           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet Wallet?

  savingsPlans        SavingsPlan[]
  fundHoldings        FundHolding[]
  fundTransactions    FundTransaction[]
  circlesCreated      Circle[]
  circleMemberships   CircleMember[]
  circleContributions CircleContribution[]
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

enum TransactionType {
  FUNDING
  WITHDRAWAL
  SAVINGS_FUNDING
  SAVINGS_WITHDRAWAL
  CIRCLE_CONTRIBUTION
  CIRCLE_PAYOUT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Transaction {
  id                String            @id @default(uuid())
  walletId          String
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  savingsPlanId     String?
  savingsPlan       SavingsPlan?      @relation(fields: [savingsPlanId], references: [id])
  circleId          String?
  circle            Circle?           @relation(fields: [circleId], references: [id])
  type              TransactionType
  amount            BigInt
  status            TransactionStatus @default(PENDING)
  providerReference String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum SavingsPlanType {
  FLEX
  FIXED
  RECURRING
}

enum SavingsPlanStatus {
  ACTIVE
  WITHDRAWN
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model SavingsPlan {
  id                   String              @id @default(uuid())
  userId               String
  user                 User                @relation(fields: [userId], references: [id])
  planType             SavingsPlanType
  targetAmount         BigInt
  currentBalance       BigInt              @default(0)
  maturityDate         DateTime?
  frequency            RecurringFrequency?
  recurringAmount      BigInt?
  lastRecurringDebitAt DateTime?
  status               SavingsPlanStatus   @default(ACTIVE)
  lastAccruedAt        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  transactions     Transaction[]
  interestAccruals InterestAccrual[]
}

model InterestAccrual {
  id            String      @id @default(uuid())
  savingsPlanId String
  savingsPlan   SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  accrualDate   DateTime    @db.Date
  amount        BigInt
  createdAt     DateTime    @default(now())

  @@unique([savingsPlanId, accrualDate])
}

enum FundCategory {
  MONEY_MARKET
  FIXED_INCOME
  EQUITY
  MIXED
}

model Fund {
  id         String       @id @default(uuid())
  name       String
  manager    String
  category   FundCategory
  navPerUnit Decimal
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  navHistory   FundNavHistory[]
  holdings     FundHolding[]
  transactions FundTransaction[]
}

model FundNavHistory {
  id         String   @id @default(uuid())
  fundId     String
  fund       Fund     @relation(fields: [fundId], references: [id])
  navPerUnit Decimal
  recordedAt DateTime @default(now())
}

model FundHolding {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fundId    String
  fund      Fund     @relation(fields: [fundId], references: [id])
  units     Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fundId])
}

enum FundTransactionType {
  BUY
  REDEEM
}

model FundTransaction {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id])
  fundId     String
  fund       Fund                @relation(fields: [fundId], references: [id])
  type       FundTransactionType
  amount     BigInt
  units      Decimal
  navPerUnit Decimal
  createdAt  DateTime            @default(now())
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

enum CircleStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model Circle {
  id                 String             @id @default(uuid())
  name               String
  creatorId          String
  creator            User               @relation(fields: [creatorId], references: [id])
  contributionAmount BigInt
  frequency          RecurringFrequency
  maxMembers         Int
  currentRound       Int                @default(1)
  status             CircleStatus       @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members       CircleMember[]
  contributions CircleContribution[]
  transactions  Transaction[]
}

model CircleMember {
  id                String   @id @default(uuid())
  circleId          String
  circle            Circle   @relation(fields: [circleId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  position          Int
  hasReceivedPayout Boolean  @default(false)
  joinedAt          DateTime @default(now())

  @@unique([circleId, userId])
  @@unique([circleId, position])
}

model CircleContribution {
  id        String   @id @default(uuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  round     Int
  amount    BigInt
  createdAt DateTime @default(now())

  @@unique([circleId, userId, round])
}
